<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Transparent WebP -> AVIF fallback during migration
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.avif -f
  RewriteRule ^(.*)\.webp$ /$1.avif [T=image/avif,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/(photos|thumbnails|avif|webp|scrubber|recap|data|assets)/ [NC]
  RewriteCond %{REQUEST_URI} !\.(jpe?g|png|gif|svg|webp|avif|ico|woff2?|ttf|otf|json|zip)$ [NC]
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  # Enable Gzip / Deflate compression for text, script, JSON, CSS, and SVG assets
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Baseline security headers
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://stats.wftda.com; frame-src 'self' https://stats.wftda.com; object-src 'none'; base-uri 'self';"

  # 1. Never cache HTML, Service Workers, or Web Manifest (always fetch fresh)
  # Uses 'always' so headers apply across internal rewrites and subrequests (SPA routing)
  <FilesMatch "(?i)\.(html|webmanifest)$|^sw\.js$|^workbox-.*\.js$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    # Instruct Cloudflare & edge CDNs to bypass caching for dynamic shell and service workers
    Header always set CDN-Cache-Control "no-store"
    Header always set Cloudflare-CDN-Cache-Control "no-store"
  </FilesMatch>

  # 2. Aggressively cache Vite's hashed assets (JS, CSS) for 1 year
  <If "%{REQUEST_URI} =~ m#^/assets/.*#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # 3. Always revalidate JSON data with origin (supports 304 Not Modified, avoids stale reads)
  <FilesMatch "\.json$">
    Header always set Cache-Control "public, no-cache, must-revalidate"
    Header always set Pragma "no-cache"
  </FilesMatch>

  # 4. Aggressively cache images and fonts for 1 year
  <FilesMatch "\.(jpeg|jpg|png|gif|svg|webp|avif|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 5. Serve zip files as downloads with correct MIME type
  <FilesMatch "\.zip$">
    Header set Content-Type "application/zip"
    Header set Content-Disposition "attachment"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType application/zip .zip
  AddType font/woff2 .woff2
</IfModule>

