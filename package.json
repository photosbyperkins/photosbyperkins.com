{
  "name": "photosbyperkins",
  "private": false,
  "version": "1.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/build.ts",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.scripts.json --noEmit",
    "pipeline": "tsx scripts/build.ts",
    "predeploy": "npm run build:client",
    "deploy": "tsx scripts/deploy.ts",
    "clean": "tsx scripts/pipeline/cleanDist.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "test": "vitest run",
    "test:e2e": "npx playwright test",
    "favicon": "tsx scripts/pipeline/generateFavicon.ts",
    "faces": "python scripts/detectFaces.py",
    "populate-scores": "tsx scripts/populateEventScores.ts",
    "fix-permissions": "tsx scripts/fixPermissions.ts",
    "sync-media": "tsx scripts/syncMedia.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@nrs-binding/ssimulacra2": "^1.0.23",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^8.0.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "exifr": "^7.1.3",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "puppeteer": "^25.12.0",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.0.0",
    "fuse.js": "^7.5.0",
    "mediabunny": "^1.61.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  }
}
